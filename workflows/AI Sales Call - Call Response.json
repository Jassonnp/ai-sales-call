      "parameters": {
        "jsCode": "return items.map(item => {\n  // 1. Parse the JSON string from the input item.\n  const leadData = JSON.parse(item.json.data);\n\n  // 2. Safely extract and simplify contacts in one line.\n  //    The `?.` prevents errors if 'contacts' doesn't exist,\n  //    and `|| []` provides an empty array as a fallback.\n  const contacts = leadData._embedded?.contacts?.map(c => ({\n    id: c.id,\n    name: c.name,\n  })) || [];\n\n  // 3. Safely get the company ID.\n  const companyId = leadData._embedded?.companies?.[0]?.id || null;\n\n  // 4. Return the new, clean object for this item.\n  //    The .map function automatically collects all returned\n  //    objects into the final output array.\n  return {\n    lead_id: leadData.id,\n    lead_name: leadData.name,\n    status_id: leadData.status_id,\n    pipeline_id: leadData.pipeline_id,\n    created_date: new Date(leadData.created_at * 1000).toISOString(),\n    company_id: companyId,\n    contacts: contacts,\n  };\n});"
      },
