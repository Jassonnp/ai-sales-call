    {
      "parameters": {
        "jsCode": "// Use .map() to transform each input item into a simplified output object.\nreturn items.map(item => {\n  // 1. Parse the JSON string from the 'data' property into a usable object.\n  const contactData = JSON.parse(item.json.data);\n\n  // 2. Find the custom field object for the phone number.\n  const phoneField = contactData.custom_fields_values?.find(\n    field => field.field_code === 'PHONE'\n  );\n\n  // 3. Find the custom field object for the email address.\n  const emailField = contactData.custom_fields_values?.find(\n    field => field.field_code === 'EMAIL'\n  );\n\n  // 4. Safely extract the values from the found fields.\n  const phoneNumber = phoneField?.values?.[0]?.value || null;\n  const emailAddress = emailField?.values?.[0]?.value || null;\n\n  // 5. Safely extract the associated company ID.\n  const companyId = contactData._embedded?.companies?.[0]?.id || null;\n\n  // 6. Return a new, clean object with all the essential information.\n  return {\n    contact_id: contactData.id,\n    contact_name: contactData.name,\n    phone_number: phoneNumber,\n    contact_email: emailAddress,\n    associated_company_id: companyId\n  };\n});"
      },
